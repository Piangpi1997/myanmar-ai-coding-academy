SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_JWT_AUDIENCE=authenticated
# Optional comma-separated web origins (native Android does not use CORS).
ALLOWED_ORIGINS=
# Dedicated patched Judge0 deployment. Never put this token in the APK.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_PYTHON_ID=71
# Set true only after verifying isolation, filesystem restrictions and blocked network egress.
JUDGE0_SANDBOX_VERIFIED=false
# AI keys are supplied by each user per request. No shared AI API key is needed.
